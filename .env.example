# Kaggle Configuration
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
KAGGLE_DATASET_NAME=athletic-intelligence-dataset

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# Video Processing
TARGET_FPS=30
TARGET_RESOLUTION=640x480
MAX_VIDEO_SIZE_MB=500

# YOLO Detection
DETECTION_MODEL=yolov8m
DETECTION_CONFIDENCE=0.5

# Data Paths
UPLOADS_DIR=src/backend/data/uploads
OUTPUTS_DIR=src/backend/data/outputs
MODELS_DIR=src/backend/data/models

# Job Configuration
JOB_TIMEOUT_SECONDS=300
JOB_RETENTION_HOURS=24

# Async Processing (if scaling)
ASYNC_PROCESSING=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=your-random-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (optional, if using SQLite for job tracking)
DATABASE_URL=sqlite:///./offside_detection.db
